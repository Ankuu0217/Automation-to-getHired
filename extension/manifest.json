{
  "manifest_version": 3,
  "name": "GetHired — Send job post",
  "short_name": "GetHired",
  "version": "1.0.0",
  "description": "Send a LinkedIn (or any) job post to GetHired in one click — as selected text or a screenshot of what you see.",
  "action": { "default_popup": "popup.html", "default_title": "Send to GetHired", "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "commands": {
    "send-selection": { "suggested_key": { "default": "Alt+Shift+G" }, "description": "Send selected text to GetHired" }
  }
}
