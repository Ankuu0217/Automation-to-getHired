# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public base URL of this server — used for tracking-pixel URLs in sent emails (M4)
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# MongoDB (docker compose up -d starts a local instance matching this URI)
MONGODB_URI=mongodb://localhost:27017/jobmail

# Auth secrets — use long random strings in production
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# AES-256-GCM key: exactly 32 bytes as 64 hex chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Optional versioned keyring for KEY ROTATION (leave unset to just use ENCRYPTION_KEY
# as version 00). Format: "NN:<64hex>,NN:<64hex>" — NN is a 2-hex-digit version and
# the FIRST entry is the primary (encrypts); the rest stay available for decrypt.
# Rotate = prepend a new primary, keep the old key for decrypt; secrets re-encrypt
# lazily on their next write (e.g. the Gmail token's next refresh).
#   ENCRYPTION_KEYS=01:<newhex>,00:<oldhex>
ENCRYPTION_KEYS=

# Set to true when serving over HTTPS (production)
COOKIE_SECURE=false

# ── AI (M2+; optional for M1) ───────────────────────────────────────────
# OpenRouter — primary AI (https://openrouter.ai/keys). Free models are tried in
# order with automatic failover; Gemini below is the second engine if set.
# Tip: a one-time $10 credit top-up raises free-model limits from 50 to 1000 requests/day.
OPENROUTER_API_KEY=
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# OPENROUTER_VISION_MODELS=
GEMINI_API_KEY=
# Gemini model override (defaults to gemini-1.5-flash when unset)
GEMINI_MODEL=

# ── Gmail OAuth2 (M3+; optional — /gmail/connect 503s without these) ────
# PRODUCTION multi-user checklist (see the feature doc, Gap A/J):
#  - GMAIL_REDIRECT_URI must be a real HTTPS URL, registered in the Google Cloud
#    Console (not localhost).
#  - Publish + verify the OAuth consent screen (sensitive-scope review for
#    gmail.send). Until then only added Test users can connect and their refresh
#    token expires after 7 days.
#  - Requires a public privacy policy + Limited Use disclosure linked on the
#    consent screen; in-app data deletion + token revoke already ship.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/gmail/callback

# ── Gmail App Password DEV-ONLY fallback (sends when no OAuth is connected) ──
# NOT a multi-user path: it sends every user's outreach from this one mailbox.
# Automatically disabled when NODE_ENV=production.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── File storage: ImageKit (recommended for production) ────────────────
# Set both to store resumes + screenshots in ImageKit as PRIVATE files
# (served only via short-lived signed URLs). Leave empty → local disk
# (server/uploads), which needs a persistent disk in production.
# Dashboard → Developer options: private key + URL endpoint.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# Optional root folder in your media library (default: gethired)
# IMAGEKIT_FOLDER=gethired

# ── System mail sender (email-verification links) ───────────────────────
# Preferred: Brevo HTTPS API (free 300/day) — works where SMTP ports are blocked
# (Render free). MAIL_FROM must be a sender you verified in Brevo.
# BREVO_API_KEY=
# MAIL_FROM="GetHired <yourname@gmail.com>"
# SMTP alternative (hosts that allow outbound SMTP):
# REQUIRED in production, otherwise new users never receive their verification
# link and can't send. Any SMTP provider works (Brevo, Resend, SES, Mailgun…).
# If unset, GMAIL_USER/GMAIL_APP_PASSWORD above is used as the system sender.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="GetHired <no-reply@yourdomain.com>"

# ── Production ─────────────────────────────────────────────────────────
# Vercel (frontend) + Render (API): CLIENT_URL = the Vercel URL, API_URL = the
# Render URL, GMAIL_REDIRECT_URI = <Vercel URL>/api/v1/gmail/callback,
# TRUST_PROXY=2. See DEPLOYMENT.md §5.
# Single Render service instead: the server also serves client/dist (after
# `pnpm build`), so API_URL = CLIENT_URL = that one URL and TRUST_PROXY=1.
# Production refuses to boot with the placeholder JWT secrets above.
# CLIENT_DIST_DIR=   # optional override for the built client location

# ── Scale knobs (defaults fit one 1 CPU / 2 GB instance ≈ 1000 users) ─
# Reverse-proxy hops in front of the app (Render/Railway/Fly/Nginx = 1).
# Wrong value ⇒ every user shares one rate-limit IP. Keep 1 unless told otherwise.
# TRUST_PROXY=1
# Multipart uploads buffered in RAM at once (each ≤10 MB); extra requests wait.
# UPLOAD_CONCURRENCY=8
# Screenshot/text extractions running at once (Gemini + OCR fallback).
# EXTRACTION_CONCURRENCY=4
# Parallel send / follow-up jobs per instance.
# QUEUE_SEND_CONCURRENCY=5
# Delete stored job screenshots after N days (extracted data is kept). 0 = never.
# SCREENSHOT_RETENTION_DAYS=30
# OCR fallback when Gemini can't read a screenshot (CPU-heavy). false on free hosts.
# OCR_ENABLED=true
# Password hashing cost (10–14). 10 on 0.1-CPU free instances; old hashes still verify.
# BCRYPT_COST=12
# Cheaper model for text-only AI calls (pasted JD, match, email writing);
# screenshots always use GEMINI_MODEL. Leave empty to use GEMINI_MODEL for all.
# GEMINI_TEXT_MODEL=

# ── Queue (M3+) ─────────────────────────────────────────────────────────
# 'true' processes send jobs inline instead of via Agenda. Defaults to true in
# development (immediate sends, no worker loop dependency) and false in production
# (persisted queue). Override here only if you explicitly want Agenda in dev.
# QUEUE_INLINE=true
