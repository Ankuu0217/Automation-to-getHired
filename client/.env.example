# Optional override for the API base URL.
# By default the client calls the same-origin `/api/v1` path, which the Vite
# dev server proxies to http://localhost:4000 (see vite.config.ts) so that
# the httpOnly auth cookies stay same-origin in development.
# Set this only if you need to point the client at a different API origin,
# e.g. VITE_API_URL=https://api.example.com/api/v1
# VITE_API_URL=
# ⚠ Leave VITE_API_URL UNSET on Vercel: vercel.json proxies /api/* to Render so
# cookies stay same-origin. Pointing at the Render URL directly breaks login.

# Support / privacy contact shown on the public /privacy page (required for
# Google OAuth verification). Build-time variable: set it where `pnpm build` runs.
# VITE_CONTACT_EMAIL=support@yourdomain.com

# Set to true once Gemini billing is on — removes the free-tier data-use notice on /privacy.
# VITE_GEMINI_PAID=true
